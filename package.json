{
	"private": true,
	"name": "trashttpandas",
	"version": "2.0.0",
	"description": "An API for HTTP Raccoons on Cloudflare Workers.",
	"scripts": {
		"dev": "wrangler dev",
		"dev:remote": "wrangler dev --remote",
		"deploy": "wrangler deploy --minify",
		"typecheck": "wrangler types && tsc --noEmit",
		"format": "biome format --write .",
		"lint": "biome check .",
		"thumbnails": "node scripts/generate-thumbnails.mjs"
	},
	"author": "Leon San José Larsson",
	"license": "MIT",
	"dependencies": {
		"hono": "^4.13.8"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"sharp": "^0.35.4",
		"typescript": "^7.0.2",
		"wrangler": "^4.135.0"
	},
	"packageManager": "pnpm@11.22.0"
}
